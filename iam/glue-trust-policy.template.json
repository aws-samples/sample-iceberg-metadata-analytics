{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowGlueServiceAssume",
      "Effect": "Allow",
      "Principal": { "Service": "glue.amazonaws.com" },
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession"
      ],
      "Condition": {
        "StringEquals": { "aws:SourceAccount": "__ACCOUNT_ID__" },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:glue:__REGION__:__ACCOUNT_ID__:*"
        }
      }
    }
  ]
}
